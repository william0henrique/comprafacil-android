# Client API base URL for local development.
# Set this to an address reachable from the Android device; leave blank for local-only flows.
EXPO_PUBLIC_API_BASE_URL=

# Optional server-side proxy for nearby supermarket lookup.
# Keep these values on the server. Never put a secret in an EXPO_PUBLIC_* variable.
# Without them, nearby lookup is unavailable; manual stores and local comparison still work.
MANUS_API_URL=
MANUS_API_KEY=
